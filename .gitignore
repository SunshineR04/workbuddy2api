# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin
/login.exe
/credit.exe
/wb2api.exe
/signin_bin.exe

# Windows 本地构建产物：start.ps1 / stats.ps1 / login.ps1 把编译好的 exe 落在这里
# （上游无此目录 —— .sh 与 Dockerfile 都是现场编译、用完即弃）。
# 同样锚定根目录：裸写 "bin/" 会连任意深度的 bin/ 一起忽略，将来上游若新增
# 包含源码的 xxx/bin/，就会被静默忽略。
/bin/

# Config with secrets (use config.example.json)
config.json
# 备份副本同样含 api_key 明文：上面那条是精确匹配，盖不住 config.json.bak-* 这类变体，
# 而这几个备份恰恰是仓库里最容易误提交的敏感文件。
config.json.bak
config.json.bak-*

# Build artifacts
*.tmp
__pycache__/

# 运行时产物（API Key / 进程号 / 日志 / 工具草稿目录）
# 为什么显式列 .apikey：它不是 config.json 的别名，而是 login.sh 等工具单独落盘的密钥文件，
# 不写进这里会被 git add -A 直接提交（含明文 api_key）。
.apikey
.server.pid
wb2api.pid
*.log
draft_*_folder/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# Windows 本地运维脚本。逐个列名而不用 *.ps1：stats.ps1 是仓库跟踪文件，
# 通配符会让它的后续改动与新文件落入两种不同规则，语义混乱。
/start.ps1
/stop.ps1
/login.ps1

# 本机临时数据 / 日志 / 基准脚本
/effort_bench.py
/wb_models.json
/offpeak_probes.log
/cmd/travelchk/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md
